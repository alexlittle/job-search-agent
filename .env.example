# Copy this file to .env and fill in your own values.
# Create an API key at https://platform.claude.com/ (Console, not your Claude.ai login) —
# see tasks.md Phase 0 for setting a spend cap alongside it.
ANTHROPIC_API_KEY=

# Sent as contact info in the User-Agent header when fetching external job sites/APIs — use
# your own email, not the original author's. Good etiquette for anything scraping/polling a
# site you don't control, and some sites expect it.
CONTACT_EMAIL=

# Optional app-level guards on top of the Anthropic Console spend cap (see tasks.md Phase 0/12) —
# cap how many listings a single Haiku/Sonnet batch takes on, and a pre-flight worst-case cost
# estimate above which a batch is refused rather than submitted. Both have sane defaults
# (50 listings / $2.00) if left unset.
# MAX_LISTINGS_PER_RUN=50
# MAX_SPEND_PER_RUN_USD=2.00

# Optional - Adzuna API credentials (tasks.md Phase 13), a second structured job source alongside
# the RSS feeds. Register an app at https://developer.adzuna.com/ (separate from a regular Adzuna
# job-seeker account) to get these. Left unset, the Adzuna source is skipped rather than the
# pipeline failing - it's an addition, not a requirement.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
