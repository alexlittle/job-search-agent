# Copy this file to .env and fill in your own values.
# Create an API key at https://platform.claude.com/ (Console, not your Claude.ai login) —
# see tasks.md Phase 0 for setting a spend cap alongside it.
ANTHROPIC_API_KEY=

# Sent as contact info in the User-Agent header when fetching external job sites/APIs — use
# your own email, not the original author's. Good etiquette for anything scraping/polling a
# site you don't control, and some sites expect it.
CONTACT_EMAIL=
